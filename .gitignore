# ============================================================
#  Keep secrets and machine-specific files OUT of git.
#  If you ever run `git init` in this folder, these are ignored.
# ============================================================

# --- Secrets / credentials (NEVER commit these) ---
service_account.json
config.json
# backups/variants of config.json (e.g. *.pre-zip-import.bak)
config.json*
*.pem
*.key
.env
# App backup archives -- these bundle a full config.json with LIVE credentials, so a
# zip of the app must NEVER be committed. (e.g. "new app for brands shopify to amazon.zip")
*.zip

# --- Local data caches / runtime state (machine-specific, per CLAUDE.md §2 — never commit) ---
# These are written at runtime (they live on the persistent disk on the server), so they
# change every time the app runs -- they are app STATE, not code / bug fixes.
miles_bundles_store.json
miles_bundles.json
miles_harvested.json
miles_items.json
miles_ui_prefs.json
model_number_counter.json
attribute_defaults.json
app_state.json
# two-way Amazon<->app sync caches (feature 2): last-known-Amazon snapshots + live
# per-account pull-capability results. Runtime state, machine-specific -- never commit.
sync_snapshots.json
sync_capability.json
# ASIN Monitor: tracked-ASIN list + (later) offer-snapshot history. Runtime state.
asin_monitor.json
asin_monitor_history.json
# User accounts: emails, permissions and PASSWORD HASHES. Never commit -- a hash
# is not a password, but it is still credential material and it names every
# person with access to the app.
users.json
# Durable live-catalogue snapshots. Runtime state, per-machine, can be large.
live_snapshots.json
# The SQLite database. This is the DATA -- every listing, price, cost and note.
# Never commit it: it is large, it is binary (so every change is an unreadable
# diff), and it holds commercial information that has no business in a git
# history. -wal and -shm are SQLite's write-ahead sidecar files.
altascraper.db
altascraper.db-wal
altascraper.db-shm
*.db
*.db-wal
*.db-shm

# --- Session baselines (bug-check snapshots, per CLAUDE.md §3 — never commit) ---
*.baseline.py

# --- Runtime / machine-specific ---
.venv/
.app_port
.DS_Store

# --- Python caches ---
__pycache__/
*.py[cod]
*.egg-info/

# --- Generated output folders (runtime; these become persistent-disk mounts on the server) ---
media/
uploads/
inventory_out/
ppc_out/
brands/
miles_templates/
files/
autofix_logs/
filled_unified_template.xlsm

# --- Stray local artifacts, not part of the app ---
python-3.14.6-macos11.pkg
KITCHEN_COOKWARE_SET_FOOD_SPATULA_KITCHEN_KNIFE_HARDWARE__2_.xlsm

# Miles harvest/generate run logs (local run history)
miles_runs/

# Live run heartbeat -- rewritten constantly while a run is going, local only
run_status.json

# Local run logs (beta app, dev server). Per-machine, never useful in the repo.
*.log

# Word lock files -- created while a .docx is open, deleted when it closes.
~$*.docx

# run_tests.py's lock, held only while a suite is running. Per-machine.
.run_tests.lock

# The disk-persistence marker. Written beside config.json on every boot, and it
# describes ONE machine's filesystem -- committing it would carry the dev box's
# boot history to the server and make the "has this folder survived a deploy"
# answer a lie.
.disk_history.json

# Which (account, marketplace) pairs Amazon is currently refusing. Per-machine
# runtime state, written beside config.json -- committing it would carry this
# box's failures to the server and rest marketplaces that work fine there.
marketplace_health.json
